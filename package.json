{
  "name": "samhanji",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "삼한지(三韓志): 천하삼분 — 한국 삼국시대 그랜드 스트래티지 프로토타입",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "validate": "tsx scripts/validate-data.ts",
    "build:castles": "tsx scripts/build-castles.ts",
    "build:officers": "tsx scripts/build-officers.ts",
    "build:data": "npm run build:castles && npm run build:officers && npm run validate",
    "simulate": "tsx scripts/simulate.ts",
    "test": "tsx scripts/test.ts",
    "smoke:browser": "node scripts/dev/browser-smoke.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
